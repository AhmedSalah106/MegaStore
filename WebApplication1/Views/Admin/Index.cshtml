@model AdminDashBoardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">Admin Dashboard</h2>

    <!-- Stats Overview -->
    <div class="row text-center">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Sales</h5>
                    <p class="card-text">@Model.TotalSales.ToString("C")</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Users</h5>
                    <p class="card-text">@Model.TotalUsers</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Products</h5>
                    <p class="card-text">@Model.TotalProducts</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Orders</h5>
                    <p class="card-text">@Model.TotalOrders</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Vendor Section -->
    <h4 class="mt-4">Vendors List</h4>

    <!-- Search Box -->
    <div class="mb-3">
        <input type="text" id="vendorSearch" class="form-control" placeholder="Search vendor by name..." onkeyup="filterVendors()">
    </div>

    <div class="row" id="vendorCardsContainer">
        @foreach (var vendor in Model.vendors)
        {
            <div class="col-md-4 vendor-card" data-name="@vendor.Name.ToLower()">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center">
                        <h5 class="card-title" onclick="toggleVendorDetails(@vendor.Id)" style="cursor: pointer;">
                            @vendor.Name <span id="toggle-icon-@vendor.Id">➕</span>
                        </h5>
                        <div id="vendor-details-@vendor.Id" class="vendor-details" style="display: none; background: rgba(255, 255, 255, 0.2); padding: 10px; border-top: 1px solid white;">
                            <p><strong>Email:</strong> @vendor.Email</p>
                            <p><strong>Phone:</strong> @vendor.PhoneNumber</p>
                            <p><strong>Address:</strong> @vendor.Address</p>
                            <p><strong>Total Sales:</strong> $@vendor.TotalSaled.ToString("N2")</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination Controls -->
    <div class="d-flex justify-content-center mt-3">
        <button id="prevPage" class="btn btn-secondary mx-2" onclick="changePage(-1)" disabled>&lt;</button>
        <button id="nextPage" class="btn btn-secondary mx-2" onclick="changePage(1)">&gt;</button>
    </div>
</div>

<!-- JavaScript -->
<script>
    let currentPage = 1;
    const vendorsPerPage = 3;
    let allVendors = [...document.querySelectorAll(".vendor-card")];

    function paginateVendors(vendors = allVendors) {
        let totalVendors = vendors.length;
        let totalPages = Math.ceil(totalVendors / vendorsPerPage);

        vendors.forEach((card, index) => {
            card.style.display = (index >= (currentPage - 1) * vendorsPerPage && index < currentPage * vendorsPerPage) ? "block" : "none";
        });

        document.getElementById("prevPage").disabled = currentPage === 1;
        document.getElementById("nextPage").disabled = currentPage === totalPages;
    }

    function changePage(direction) {
        currentPage += direction;
        paginateVendors();
    }

    function toggleVendorDetails(id) {
        let detailsDiv = document.getElementById(`vendor-details-${id}`);
        let icon = document.getElementById(`toggle-icon-${id}`);

        if (detailsDiv.style.display === "none") {
            detailsDiv.style.display = "block";
            icon.textContent = "➖";
        } else {
            detailsDiv.style.display = "none";
            icon.textContent = "➕";
        }
    }

    function filterVendors() {
        let searchQuery = document.getElementById("vendorSearch").value.toLowerCase();
        let vendorCards = document.querySelectorAll(".vendor-card");

        let filteredVendors = [...vendorCards].filter(card => {
            let vendorName = card.getAttribute("data-name");
            return vendorName.includes(searchQuery);
        });

        allVendors.forEach(card => card.style.display = "none"); // Hide all vendors
        currentPage = 1; // Reset pagination for filtered results
        paginateVendors(filteredVendors);
    }

    // Initialize Pagination
    paginateVendors();
</script>
