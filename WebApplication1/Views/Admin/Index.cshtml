@model AdminDashBoardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4">Admin Dashboard</h2>

    <!-- Stats Overview -->
    <div class="row">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Sales</h5>
                    <p class="card-text">@(Model.TotalSales > 0 ? Model.TotalSales.ToString("C") : "$0")</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Users</h5>
                    <p class="card-text">@(Model.TotalUsers > 0 ? Model.TotalUsers : 0)</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Products</h5>
                    <p class="card-text">@(Model.TotalProducts > 0 ? Model.TotalProducts : 0)</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-danger mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Orders</h5>
                    <p class="card-text">@(Model.TotalOrders > 0 ? Model.TotalOrders : 0)</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Button to Show Vendors -->
    <button class="btn btn-primary mt-4" onclick="toggleVendors()">
        <i class="fas fa-users"></i> View Vendors
    </button>

    <!-- Vendor Search Input -->
    <div id="vendorSearchContainer" style="display: none; margin-top: 10px;">
        <input type="text" id="vendorSearch" class="form-control mb-3" placeholder="Search vendors by name..." onkeyup="filterVendors()">
    </div>

    <!-- Vendors Section (Initially Hidden) -->
    <div id="vendorsSection" style="display: none; margin-top: 20px;">
        <h4 class="mt-4">Vendors List</h4>

        @if (Model.vendors != null && Model.vendors.Any())
        {
            <div class="row" id="vendorList">
                @foreach (var vendor in Model.vendors)
                {
                    <div class="col-md-4 vendor-card">
                        <div class="card border-primary mb-3 shadow-sm">
                            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">@vendor.Name</h5>
                                <button class="btn btn-light btn-sm" onclick="toggleVendorDetails(this)">
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                            <div class="card-body vendor-details" style="display: none;">
                                <p><i class="fas fa-envelope"></i> <strong>Email:</strong> @vendor.Email</p>
                                <p><i class="fas fa-phone"></i> <strong>Phone:</strong> @vendor.PhoneNumber</p>
                                <p><i class="fas fa-map-marker-alt"></i> <strong>Address:</strong> @(string.IsNullOrEmpty(vendor.Address) ? "Not Provided" : vendor.Address)</p>
                                <p><i class="fas fa-dollar-sign"></i> <strong>Total Sales:</strong> @vendor.TotalSaled.ToString("C")</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No vendors available.</p>
        }
    </div>
</div>

<script>
    function toggleVendors() {
        var vendorsSection = document.getElementById("vendorsSection");
        var searchContainer = document.getElementById("vendorSearchContainer");

        if (vendorsSection.style.display === "none") {
            vendorsSection.style.display = "block";
            searchContainer.style.display = "block";
        } else {
            vendorsSection.style.display = "none";
            searchContainer.style.display = "none";
        }
    }

    function toggleVendorDetails(button) {
        var cardBody = button.closest(".card").querySelector(".vendor-details");
        if (cardBody.style.display === "none") {
            cardBody.style.display = "block";
            button.innerHTML = '<i class="fas fa-chevron-up"></i>';
        } else {
            cardBody.style.display = "none";
            button.innerHTML = '<i class="fas fa-chevron-down"></i>';
        }
    }

    function filterVendors() {
        var input = document.getElementById("vendorSearch").value.toLowerCase();
        var vendorCards = document.querySelectorAll(".vendor-card");

        vendorCards.forEach(function (card) {
            var name = card.querySelector(".card-header h5").innerText.toLowerCase();
            if (name.includes(input)) {
                card.style.display = "block";
            } else {
                card.style.display = "none";
            }
        });
    }
</script>
